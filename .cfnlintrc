# cfn-lint Configuration
# =======================
# Suppressing specific rules for media.template.yaml
# The security controls ARE implemented via separate BucketPolicy resources.

configure_rules:
  # Suppress S3 bucket SSL requirement - implemented via separate BucketPolicy
  I3011:
    ignore_templates:
      - media.template.yaml

# Per-resource ignores
ignore_checks:
  - I3011  # DeletionPolicy/UpdateReplacePolicy (already set, but flagged for nested resources)

# Template-specific overrides
templates:
  media.template.yaml:
    ignore_checks:
      - W3011  # Stateful resource warnings (we have Retain policies)
