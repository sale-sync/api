{
  "name": "openapi",
  "root": "apps/api/openapi",
  "sourceRoot": "apps/api/openapi",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run start",
        "cwd": "apps/api/openapi"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/api/openapi"
      }
    }
  }
}
