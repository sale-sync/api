{
    "name": "@sales-sync-admin-api/auth",
    "version": "1.0.0",
    "description": "Sales Sync Admin — staff Cognito login/callback Lambda",
    "main": "app.js",
    "author": "SAM CLI",
    "license": "MIT",
    "scripts": {
        "unit": "jest",
        "test:integration": "jest --testPathPattern=tests/integration",
        "lint": "eslint '*.ts' --quiet --fix",
        "compile": "tsc",
        "bundle": "esbuild app.ts --bundle --platform=node --format=cjs --target=es2020 --sourcemap --outfile=bundle/app.js",
        "bundle:watch": "esbuild app.ts --bundle --platform=node --format=cjs --target=es2020 --sourcemap --outfile=bundle/app.js --watch",
        "test": "npm run compile && npm run unit"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.893.0",
        "@aws-sdk/lib-dynamodb": "^3.893.0",
        "@devyethiha/samjs": "^0.1.18",
        "@sale-sync/shared": "file:../../../libs/shared",
        "esbuild": "^0.14.14",
        "openid-client": "^5.7.1"
    },
    "devDependencies": {
        "aws-sdk-client-mock": "^4.1.0",
        "aws-sdk-client-mock-jest": "^4.1.0",
        "@jest/globals": "^29.2.0",
        "@types/aws-lambda": "^8.10.92",
        "@types/jest": "^29.2.0",
        "@types/node": "^20.5.7",
        "jest": "^29.2.1",
        "ts-jest": "^29.0.5",
        "typescript": "^5.6.3"
    }
}
