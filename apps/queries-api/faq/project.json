{
  "name": "queries-faq",
  "root": "apps/queries-api/faq",
  "sourceRoot": "apps/queries-api/faq",
  "projectType": "application",
  "targets": {
    "compile": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run compile", "cwd": "apps/queries-api/faq" }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run bundle", "cwd": "apps/queries-api/faq" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "npm test", "cwd": "apps/queries-api/faq" }
    },
    "unit": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run unit", "cwd": "apps/queries-api/faq" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run lint", "cwd": "apps/queries-api/faq" }
    }
  }
}
