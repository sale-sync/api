{
  "name": "sale-sync-api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "auth",
    "organisation",
    "media",
    "blocks",
    "templates",
    "plan",
    "properties",
    "packages",
    "openapi"
  ],
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t compile --projects=auth,organisation,blocks,plan,templates,properties",
    "bundle": "nx run-many -t bundle --projects=auth,organisation,media,blocks,plan,templates,properties",
    "lint": "nx run-many -t lint --projects=auth,organisation,blocks,plan,templates,properties",
    "test": "nx run-many -t test --projects=auth,organisation,blocks,plan,templates,properties",
    "shared.build": "nx run shared:build",
    "shared.test": "nx run shared:test",
    "shared.lint": "nx run shared:lint",
    "openapi.start": "nx run openapi:start",
    "openapi.dev": "nx run openapi:dev",
    "samconfig:sync:staging": "node scripts/sync-samconfig.js staging staging.deploy.parameters",
    "samconfig:sync:prod": "node scripts/sync-samconfig.js prod prod.deploy.parameters",
    "clean": "rimraf node_modules auth/node_modules organisation/node_modules packages/node_modules .aws-sam"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potato-rocket-pt/sales-sync-api.git"
  },
  "devDependencies": {
    "esbuild": "^0.25.11",
    "nodemon": "^3.1.10",
    "nx": "22.1.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.6.3"
  },
  "keywords": [],
  "author": "Ye Thiha",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/potato-rocket-pt/sales-sync-api/issues"
  },
  "homepage": "https://github.com/potato-rocket-pt/sales-sync-api#readme"
}